# ---------------------------------------------------------------
# Motown Electrical Services Limited — website
# Next.js 15 (App Router) + TypeScript
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
jspm_packages/

# Next.js build output
.next/
out/
build/
dist/
.swc/

# Production / deployment
.vercel/
.netlify/
.cache/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment variables — never commit real credentials.
# Commit .env.example instead, with placeholder values.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# Logs and debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Testing and coverage
coverage/
.nyc_output/
*.lcov
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Editors and IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Temporary and scratch files
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
_to_delete/

# Archives — source is tracked in git, not in tarballs
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Local tooling
.eslintcache
.stylelintcache
.node_repl_history
*.pid
*.seed
*.pid.lock

# NOTE: public/images/ IS tracked on purpose — the company photography
# and the Open Graph share cards are part of the site, not build output.
